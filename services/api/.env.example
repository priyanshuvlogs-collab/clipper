# Pro Clipper API configuration (copy to .env)

# Storage (defaults to services/api/data)
# PRO_CLIPPER_DATA=/var/lib/proclipper

# Database — SQLite by default; PostgreSQL also supported:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/proclipper

# Local Whisper
WHISPER_MODEL=small            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto            # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto      # auto | int8 | float16

# Remote transcription fallbacks (auto-discovered when set)
# GROQ_API_KEY=gsk_...
# DEEPGRAM_API_KEY=...
# ASSEMBLYAI_API_KEY=...

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background workers
WORKER_COUNT=1
