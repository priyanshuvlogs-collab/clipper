# Pro Clipper API configuration (copy to .env)

# Storage (defaults to services/api/data)
# PRO_CLIPPER_DATA=/var/lib/proclipper

# Database — SQLite by default; PostgreSQL also supported:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/proclipper

# Local Whisper
WHISPER_MODEL=small            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto            # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto      # auto | int8 | float16

# Remote transcription fallbacks (auto-discovered when set)
# GROQ_API_KEY=gsk_...
# DEEPGRAM_API_KEY=...
# ASSEMBLYAI_API_KEY=...

# --- AI Studio (keys can also be saved from the web app: AI settings) ---
# ANTHROPIC_API_KEY=sk-ant-...   # Claude: in-app Help chat + plans AI edits
# ANTHROPIC_MODEL=claude-opus-5-5
# XAI_API_KEY=xai-...            # Grok: AI edit plans, B-roll images + video
# ELEVENLABS_API_KEY=sk_...      # voiceover, music, sound effects
# Model ids (change if xAI / ElevenLabs rename them)
# XAI_TEXT_MODEL=grok-4
# XAI_IMAGE_MODEL=grok-imagine-image
# XAI_VIDEO_MODEL=grok-imagine-video
# XAI_VIDEO_RESOLUTION=720p
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Spend guard: stop xAI generation once the ESTIMATED spend reaches this (0 = off).
# The estimate uses the rates below — set them to your account's real prices.
# AI_BUDGET_USD=10
# XAI_IMAGE_COST_USD=0.07
# XAI_VIDEO_COST_USD_PER_SEC=0.05
# XAI_TEXT_COST_USD=0.01

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background workers
WORKER_COUNT=1
