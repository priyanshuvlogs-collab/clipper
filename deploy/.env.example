# Copy to deploy/.env and fill in. Never commit deploy/.env.

# --- Site -----------------------------------------------------------------
DOMAIN=clipforge.com

# Login shown by the browser before the app opens.
APP_USER=admin
# Create the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes — the hash contains $ characters.
APP_PASSWORD_HASH='paste-the-hash-here'

# --- AI keys (optional; can also be saved in the app under AI settings) -----
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# ELEVENLABS_API_KEY=
# AI_BUDGET_USD=10

# --- Transcription ---------------------------------------------------------
# Runs on the VPS CPU. "base" is fast, "small" is more accurate (needs ~2 GB RAM).
WHISPER_MODEL=small
# A Groq key makes transcription much faster than a small VPS can manage:
# GROQ_API_KEY=
